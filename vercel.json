{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pickup.html",
      "destination": "/pickup",
      "permanent": true
    },
    {
      "source": "/storage.html",
      "destination": "/storage",
      "permanent": true
    },
    {
      "source": "/moving.html",
      "destination": "/moving",
      "permanent": true
    },
    {
      "source": "/admin-vue",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/admin-vue/",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/admin-vue/:path*",
      "destination": "/admin/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/community-post/:id",
      "destination": "/api/community-post-page?id=:id"
    },
    {
      "source": "/pickup",
      "destination": "/pickup.html"
    },
    {
      "source": "/storage",
      "destination": "/storage.html"
    },
    {
      "source": "/moving",
      "destination": "/moving.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=0, must-revalidate"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=0, must-revalidate"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/run-transport-daily-flow-test",
      "schedule": "15 */3 * * *"
    },
    {
      "path": "/api/cron/send-transport-sync-digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/run-storage-sync-audit",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/send-membership-birthday-reminders",
      "schedule": "5 0,23 * * *"
    }
  ]
}
