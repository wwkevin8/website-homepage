# Local Supabase CLI values. Copy the actual anon/service-role keys from:
#   npx supabase status
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Optional aliases used by docker-compose.yml so containers do not accidentally
# connect to the hosted Supabase project from SUPABASE_* values.
LOCAL_SUPABASE_URL=http://host.docker.internal:54321
LOCAL_SUPABASE_ANON_KEY=replace-with-local-anon-key
LOCAL_SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
DOCKER_SUPABASE_URL=http://host.docker.internal:54321

# Session and admin bootstrap
USER_SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret
ADMIN_BOOTSTRAP_USERNAME=superadmin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ADMIN_BOOTSTRAP_NAME=system-admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com

# Site URLs
APP_BASE_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
STORAGE_ORDER_ADMIN_URL=http://localhost:3000/admin/storage/orders

# Email providers and senders
RESEND_API_KEY=
AUTH_EMAIL_FROM="NGN <noreply@example.com>"
TRANSPORT_EMAIL_FROM=
TRANSPORT_PAYMENT_EMAIL_FROM=
TRANSPORT_SYNC_AUDIT_EMAIL_FROM=
TRANSPORT_SYNC_AUDIT_NOTIFY_EMAIL=
STORAGE_EMAIL_FROM=
STORAGE_STUDENT_EMAIL_FROM=
STORAGE_ORDER_NOTIFY_EMAIL=ops@example.com
STORAGE_SYNC_AUDIT_EMAIL_FROM=
STORAGE_SYNC_AUDIT_NOTIFY_EMAIL=
MEMBERSHIP_BIRTHDAY_EMAIL_FROM=
MEMBERSHIP_BIRTHDAY_NOTIFY_EMAIL=
MEMBERSHIP_BIRTHDAY_REMINDER_DEFAULT_EMAIL=

# SMTP fallback
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="NGN <mailer@example.com>"

# Optional storage webhook
STORAGE_ORDER_WEBHOOK_URL=
STORAGE_ORDER_WEBHOOK_SECRET=

# Optional public verification / captcha
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TEST_TOKEN=

# Optional media/contact customization
TRANSPORT_QR_CODE_URL=
STORAGE_SERVICE_QR_URL=/img/storage-service-qr.jpg
STORAGE_CUSTOMER_SERVICE_WECHAT=Nottsngn
STORAGE_SERVICE_CONTACT=请添加客服微信确认订单

# Cron / QA / operational settings
CRON_SECRET=
CURRENT_MEMBERSHIP_CYCLE=
MEMBERSHIP_CODE_HASH_SECRET=
STORAGE_SYNC_AUDIT_SITE_USER_CUTOVER_AT=
TRANSPORT_FLOW_TEST_PASSWORD=
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_HEADED=false
PLAYWRIGHT_QA_PASSWORD=
QA300_BASE_URL=http://localhost:3001
QA300_TURNSTILE_TOKEN=
PLAYWRIGHT_TURNSTILE_TOKEN=

# P5 order-change preview token settings
P5_CHANGE_PREVIEW_TOKEN_SECRET=
P5_CHANGE_PREVIEW_TOKEN_TTL_MS=600000
